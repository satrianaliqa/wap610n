		simpdiff \
		get_env_param \
		set_env_param \
		crc \
		e2fsprogs-1.40.4 \
		busybox-1.8.1 \
		tinytcl \
		gpio_driver \
		jffs2-etc \
		vconfig-1.9 \
		expat \
		hnap_wps_status_monitor \
		force_ethpc_renew_ip \
		ipc_api \
		detected_BrLoop \
		#iperf-2.0.2 \
		#wireless_tools.28 \
		#hostapd-0.4.10 \
