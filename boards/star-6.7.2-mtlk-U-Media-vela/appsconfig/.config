BOARD_NAME=vb
PLATFORM_SUFFIX=UMEDIA
BOARD_CUSTOMIZE=for f in $(FILES_UNUSED_IN_MINIMAL); do \
	sudo rm -rf $(E_DEST)/$$f; \
	done
HWTYPE=B5

