#!/bin/sh
# sysmon - Detailed System Resource & Process Monitor for Cisco Linksys WAP610N
# Zero dependencies, 100% uClibc / BusyBox ash compatible

read_cpu_ticks() {
	read -r _ U N S I W IRQ SIRQ _ < /proc/stat 2>/dev/null
	U=${U:-0}
	N=${N:-0}
	S=${S:-0}
	I=${I:-0}
	W=${W:-0}
	IRQ=${IRQ:-0}
	SIRQ=${SIRQ:-0}
	TOTAL=$((U + N + S + I + W + IRQ + SIRQ))
}

show_header() {
	clear 2>/dev/null || printf "\033[H\033[J"
	echo "================================================================================"
	echo " 📡 WAP610N System & Process Resource Monitor (sysmon)"
	echo "================================================================================"
}

show_system_summary() {
	# 1. Uptime & Load
	UP=$(awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60); s=int($1%60); printf "%dd %02dh %02dm %02ds", d, h, m, s}' /proc/uptime 2>/dev/null)
	LOAD=$(cat /proc/loadavg 2>/dev/null | awk '{print $1, $2, $3}')
	echo "Uptime     : $UP"
	echo "Load Avg   : $LOAD (1m, 5m, 15m)"

	# 2. CPU Usage Calculation (Accurate delta with nice + IRQ support)
	read_cpu_ticks
	if [ -n "$PREV_TOTAL" ] && [ "$TOTAL" -gt "$PREV_TOTAL" ]; then
		D_TOTAL=$((TOTAL - PREV_TOTAL))
		D_U=$(((U - PREV_U) + (N - PREV_N)))
		D_S=$(((S - PREV_S) + (IRQ - PREV_IRQ) + (SIRQ - PREV_SIRQ)))
		D_I=$((I - PREV_I))
		D_W=$((W - PREV_W))
		[ "$D_TOTAL" -le 0 ] && D_TOTAL=1
		CPU_USR=$(( (D_U * 100) / D_TOTAL ))
		CPU_SYS=$(( (D_S * 100) / D_TOTAL ))
		CPU_IDLE=$(( (D_I * 100) / D_TOTAL ))
		CPU_IO=$(( (D_W * 100) / D_TOTAL ))
		# Bound checks (0 - 100%)
		[ "$CPU_USR" -lt 0 ] && CPU_USR=0; [ "$CPU_USR" -gt 100 ] && CPU_USR=100
		[ "$CPU_SYS" -lt 0 ] && CPU_SYS=0; [ "$CPU_SYS" -gt 100 ] && CPU_SYS=100
		[ "$CPU_IDLE" -lt 0 ] && CPU_IDLE=0; [ "$CPU_IDLE" -gt 100 ] && CPU_IDLE=100
		[ "$CPU_IO" -lt 0 ] && CPU_IO=0; [ "$CPU_IO" -gt 100 ] && CPU_IO=100
		echo "CPU Usage  : Usr: ${CPU_USR}% | Sys: ${CPU_SYS}% | Idle: ${CPU_IDLE}% | IOWait: ${CPU_IO}%"
	fi
	PREV_U=$U; PREV_N=$N; PREV_S=$S; PREV_I=$I; PREV_W=$W; PREV_IRQ=$IRQ; PREV_SIRQ=$SIRQ; PREV_TOTAL=$TOTAL

	# 3. RAM Statistics
	MEM_TOT=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
	MEM_FREE=$(awk '/MemFree/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
	MEM_BUF=$(awk '/Buffers/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
	MEM_CACH=$(awk '/^Cached/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
	MEM_SLAB=$(awk '/Slab/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
	MEM_USED=$((MEM_TOT - MEM_FREE - MEM_BUF - MEM_CACH))
	
	if [ "$MEM_TOT" -gt 0 ]; then
		PCT_USED=$(( (MEM_USED * 100) / MEM_TOT ))
		echo "Memory     : Total: $((MEM_TOT / 1024)) MB ($MEM_TOT kB) | Used: $((MEM_USED / 1024)) MB (${PCT_USED}%) | Free: $((MEM_FREE / 1024)) MB"
		echo "Caches     : Buffers: $((MEM_BUF / 1024)) MB | Cached: $((MEM_CACH / 1024)) MB | Slab: $((MEM_SLAB / 1024)) MB"
	fi

	# 4. Socket Connections
	if [ -f /proc/net/tcp ]; then
		ESTAB=$(grep -c ': 01 ' /proc/net/tcp 2>/dev/null || true)
		LISTEN=$(grep -c ': 0A ' /proc/net/tcp 2>/dev/null || true)
		CW=$(grep -c ': 08 ' /proc/net/tcp 2>/dev/null || true)
		echo "Sockets    : Listen: ${LISTEN:-0} | Established: ${ESTAB:-0} | Close_Wait: ${CW:-0}"
	fi
	echo "--------------------------------------------------------------------------------"
}

show_top_processes() {
	echo "🔥 TOP PROCESSES (Sorted by CPU & RAM Usage):"
	echo "--------------------------------------------------------------------------------"
	# Use BusyBox top in batch mode for exact per-process CPU & RAM
	if command -v top >/dev/null 2>&1; then
		top -b -n 1 2>/dev/null | head -n 25 | tail -n +5
	else
		ps 2>/dev/null
	fi
	echo "================================================================================"
}

# Parse options
LOOP=0
INTERVAL=2
COUNT=0

while [ $# -gt 0 ]; do
	case "$1" in
		-l|--loop)
			LOOP=1
			if [ -n "$2" ] && echo "$2" | grep -q '^[0-9]\+$'; then
				INTERVAL="$2"
				shift
			fi
			;;
		-d)
			if [ -n "$2" ] && echo "$2" | grep -q '^[0-9]\+$'; then
				INTERVAL="$2"
				shift
			fi
			LOOP=1
			;;
		-c)
			LOOP=1
			;;
		-n)
			if [ -n "$2" ] && echo "$2" | grep -q '^[0-9]\+$'; then
				COUNT="$2"
				shift
			fi
			;;
		-h|--help)
			echo "Usage: sysmon [options]"
			echo "Options:"
			echo "  -l [sec]   Continuous monitor mode (default interval: 2s)"
			echo "  -d <sec>   Delay/interval between samples in seconds"
			echo "  -n <count> Exit after count updates"
			echo "  -c         Continuous mode (like top/htop)"
			exit 0
			;;
		*)
			;;
	esac
	shift
done

# Pre-seed initial CPU ticks
read_cpu_ticks
PREV_U=$U; PREV_N=$N; PREV_S=$S; PREV_I=$I; PREV_W=$W; PREV_IRQ=$IRQ; PREV_SIRQ=$SIRQ; PREV_TOTAL=$TOTAL

if [ "$LOOP" -eq 1 ]; then
	sleep 1
	ITER=0
	while true; do
		show_header
		show_system_summary
		show_top_processes
		echo " [Mode: Continuous (${INTERVAL}s) - Run 'sysmon' without flags for 1-shot] "
		ITER=$((ITER + 1))
		if [ "$COUNT" -gt 0 ] && [ "$ITER" -ge "$COUNT" ]; then
			break
		fi
		sleep "$INTERVAL"
	done
else
	# Single-shot mode: sleep 1s to capture accurate CPU load delta
	sleep 1
	show_header
	show_system_summary
	show_top_processes
	echo " Tip: Run 'sysmon -l' for continuous real-time monitor like htop (0 KB overhead) "
fi
