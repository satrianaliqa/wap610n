#!/bin/sh
# ============================================================================
# Lightweight POSIX JSON extractor for WAP610N / embedded Linux
# Usage: json [file] <key>  OR  cat data.json | json <key>
# ============================================================================

KEY=""
FILE=""

if [ $# -eq 1 ]; then
    KEY="$1"
elif [ $# -ge 2 ]; then
    FILE="$1"
    KEY="$2"
else
    echo "Usage: json [file] <key>" >&2
    echo "       echo '{\"ip\":\"1.2.3.4\"}' | json ip" >&2
    exit 1
fi

if [ -n "$FILE" ]; then
    if [ ! -f "$FILE" ]; then
        echo "Error: File '$FILE' not found" >&2
        exit 1
    fi
fi

do_query() {
    tr '\r\n' '  ' | awk -v target="$KEY" '
    {
        str = $0
        nkeys = split(target, keys, ".")
        for (k = 1; k <= nkeys; k++) {
            cur_key = keys[k]
            pat = "\"" cur_key "\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|\\{[^}]*\\}|\\[[^]]*\\]|[^,}\]]*)"
            if (match(str, pat)) {
                val = substr(str, RSTART, RLENGTH)
                sub(/^[^:]*:[[:space:]]*/, "", val)
                sub(/^[[:space:]]+/, "", val)
                sub(/[[:space:]]+$/, "", val)
                str = val
            } else {
                str = ""
                break
            }
        }
        sub(/^"/, "", str)
        sub(/"$/, "", str)
        if (length(str) > 0) print str
    }'
}

if [ -n "$FILE" ]; then
    do_query < "$FILE"
else
    do_query
fi
