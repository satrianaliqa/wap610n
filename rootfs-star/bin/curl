#!/bin/sh
# ============================================================================
# Lightweight POSIX curl wrapper for WAP610N / embedded Linux
# Supports GET, POST, HEAD, PUT, DELETE, custom headers, auth, data, output file
# ============================================================================

METHOD="GET"
DATA=""
HAS_DATA=0
SILENT=0
VERBOSE=0
INCLUDE_HDR=0
HEAD_ONLY=0
FOLLOW_REDIRECT=0
OUTFILE="-"
USER_AGENT="curl/7.68.0 (wap610n)"
AUTH=""
CUSTOM_HEADERS=""
CONTENT_TYPE=""
URL=""
TIMEOUT=""
NL='
'

usage() {
    echo "Usage: curl [options] <url>"
    echo "Options:"
    echo "  -d, --data <data>       HTTP POST data"
    echo "  -H, --header <header>   Custom header to pass to server"
    echo "  -I, --head              Show document info only (HEAD request)"
    echo "  -i, --include           Include protocol response headers in the output"
    echo "  -o, --output <file>     Write to file instead of stdout"
    echo "  -O, --remote-name       Write output to file named as remote file"
    echo "  -s, --silent            Silent mode (no progress or error output)"
    echo "  -u, --user <user:pass>  Server user and password (Basic Auth)"
    echo "  -v, --verbose           Make operation verbose"
    echo "  -X, --request <command> Specify request method (GET/POST/PUT/DELETE)"
    echo "  -k, --insecure          Allow insecure connections (ignored)"
    echo "  -L, --location          Follow redirects"
    exit 1
}

# Base64 encoder in pure AWK (reads payload via stdin, safe for any bytes/backslashes)
b64_encode() {
    printf "%s" "$1" | awk '
    BEGIN {
        b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        s = ""
        first = 1
    }
    {
        if (!first) s = s "\n" $0
        else { s = $0; first = 0 }
    }
    END {
        len = length(s); res = ""
        for (i = 1; i <= len; i += 3) {
            c1 = ord(substr(s, i, 1))
            c2 = (i+1 <= len) ? ord(substr(s, i+1, 1)) : 0
            c3 = (i+2 <= len) ? ord(substr(s, i+2, 1)) : 0
            n = c1 * 65536 + c2 * 256 + c3
            e1 = int(n / 262144) % 64; e2 = int(n / 4096) % 64
            e3 = int(n / 64) % 64; e4 = n % 64
            res = res substr(b64, e1+1, 1) substr(b64, e2+1, 1)
            if (i+1 <= len) res = res substr(b64, e3+1, 1); else res = res "="
            if (i+2 <= len) res = res substr(b64, e4+1, 1); else res = res "="
        }
        print res
    }
    function ord(c, i) {
        for (i=0; i<256; i++) { if (sprintf("%c", i) == c) return i }
        return 0
    }'
}

# Parse CLI options
while [ $# -gt 0 ]; do
    case "$1" in
        -s|--silent)
            SILENT=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -i|--include)
            INCLUDE_HDR=1
            shift
            ;;
        -I|--head)
            HEAD_ONLY=1
            METHOD="HEAD"
            shift
            ;;
        -X|--request)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            METHOD="$2"
            shift 2
            ;;
        -d|--data|--data-raw|--data-ascii|--data-binary|--data-urlencode)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            if [ "$HAS_DATA" -eq 1 ]; then
                DATA="${DATA}&$2"
            else
                DATA="$2"
                HAS_DATA=1
            fi
            [ "$METHOD" = "GET" ] && METHOD="POST"
            shift 2
            ;;
        -H|--header)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            case "$2" in
                [Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Tt][Yy][Pp][Ee]:*)
                    ct="${2#*:}"
                    CONTENT_TYPE=$(echo "$ct" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
                    ;;
                *)
                    CUSTOM_HEADERS="${CUSTOM_HEADERS}$2${NL}"
                    ;;
            esac
            shift 2
            ;;
        -u|--user)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            AUTH="$2"
            AUTH_USER="$2"
            shift 2
            ;;
        -A|--user-agent)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            USER_AGENT="$2"
            shift 2
            ;;
        -o|--output)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            OUTFILE="$2"
            OUT_FILE="$2"
            shift 2
            ;;
        -m|--max-time|--connect-timeout)
            [ $# -lt 2 ] && { echo "curl: option $1 requires an argument" >&2; exit 2; }
            case "$2" in
                ''|*[!0-9]*) echo "curl: invalid timeout '$2'" >&2; exit 2 ;;
                *) TIMEOUT="$2" ;;
            esac
            shift 2
            ;;
        -O|--remote-name)
            OUTFILE="__REMOTE__"
            OUT_FILE="__REMOTE__"
            shift
            ;;
        -k|--insecure)
            shift
            ;;
        -L|--location)
            FOLLOW_REDIRECT=1
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            [ "$SILENT" -eq 0 ] && echo "curl: option $1 not supported" >&2
            shift
            ;;
        *)
            URL="$1"
            shift
            ;;
    esac
done

if [ -z "$URL" ]; then
    usage
fi

# Normalize bare host/path URLs by defaulting to http://
case "$URL" in
    http://*|https://*)
        ;;
    *://*)
        [ "$SILENT" -eq 0 ] && echo "curl: unsupported protocol in URL '$URL'" >&2
        exit 1
        ;;
    *)
        URL="http://$URL"
        ;;
esac

# Reject HTTPS explicitly
case "$URL" in
    https://*)
        [ "$SILENT" -eq 0 ] && echo "curl: HTTPS is not supported on this firmware (HTTP only)" >&2
        exit 1
        ;;
esac

# Determine remote filename if -O was specified
if [ "$OUTFILE" = "__REMOTE__" ] || [ "$OUT_FILE" = "__REMOTE__" ]; then
    url_no_proto_tmp="${URL#http://}"
    case "$url_no_proto_tmp" in
        */*) fname="/${url_no_proto_tmp#*/}" ;;
        *)   fname="" ;;
    esac
    fname="${fname%%\?*}"
    fname="${fname##*/}"
    [ -z "$fname" ] && fname="index.html"
    OUTFILE="$fname"
    OUT_FILE="$fname"
fi

# Check if we can fast-path standard GET with wget
if [ "$METHOD" = "GET" ] && [ "$HAS_DATA" -eq 0 ] && [ "$INCLUDE_HDR" -eq 0 ] && [ "$HEAD_ONLY" -eq 0 ] && \
   [ "$FOLLOW_REDIRECT" -eq 0 ] && [ -z "$CUSTOM_HEADERS" ] && [ -z "$AUTH" ] && [ -z "$AUTH_USER" ] && \
   { [ "$USER_AGENT" = "curl/7.68.0 (wap610n)" ] || [ "$USER_AGENT" = "curl/7.wap610n-ash" ]; }; then
    FINAL_URL="$URL"
    TARGET_OUT="${OUT_FILE:-$OUTFILE}"
    if [ "$SILENT" -eq 1 ]; then
        if [ -n "$TARGET_OUT" ] && [ "$TARGET_OUT" != "-" ]; then
            wget -q -O "$TARGET_OUT" "$FINAL_URL"
        else
            wget -q -O - "$FINAL_URL"
        fi
    else
        if [ -n "$TARGET_OUT" ] && [ "$TARGET_OUT" != "-" ]; then
            wget -O "$TARGET_OUT" "$FINAL_URL"
        else
            wget -O - "$FINAL_URL"
        fi
    fi
    exit $?
fi

# Build Basic Auth header if requested
AUTH_HDR=""
if [ -n "$AUTH" ]; then
    b64_str=$(b64_encode "$AUTH")
    AUTH_HDR="Authorization: Basic $b64_str"
fi

NC_OPTS=""
[ -n "$TIMEOUT" ] && NC_OPTS="-w $TIMEOUT"

RESP_TMP="/tmp/curl_resp.$$"
trap 'rm -f "$RESP_TMP"' EXIT HUP INT TERM

parse_url() {
    url_no_proto="${URL#http://}"
    hostport="${url_no_proto%%/*}"
    if [ "$hostport" = "$url_no_proto" ]; then
        path="/"
    else
        path="/${url_no_proto#*/}"
    fi
    case "$hostport" in
        *\?*)
            path="/?${hostport#*\?}"
            hostport="${hostport%%\?*}"
            ;;
    esac
    case "$hostport" in
        *:*)
            host="${hostport%:*}"
            port="${hostport#*:}"
            ;;
        *)
            host="$hostport"
            port=80
            ;;
    esac
    if [ -z "$host" ]; then
        [ "$SILENT" -eq 0 ] && echo "curl: invalid URL '$URL'" >&2
        exit 3
    fi
}

do_request_to_file() {
    CLEN_HDR=""
    CTYPE_HDR=""
    if [ "$HAS_DATA" -eq 1 ]; then
        if [ -z "$CONTENT_TYPE" ]; then
            CONTENT_TYPE="application/x-www-form-urlencoded"
        fi
        clen=$(printf "%s" "$DATA" | wc -c | tr -d ' ')
        CLEN_HDR="Content-Length: $clen"
        CTYPE_HDR="Content-Type: $CONTENT_TYPE"
    elif [ -n "$CONTENT_TYPE" ]; then
        CTYPE_HDR="Content-Type: $CONTENT_TYPE"
    fi

    (
        printf "%s %s HTTP/1.0\r\n" "$METHOD" "$path"
        printf "Host: %s\r\n" "$hostport"
        printf "User-Agent: %s\r\n" "$USER_AGENT"
        printf "Accept: */*\r\n"
        printf "Connection: close\r\n"
        [ -n "$AUTH_HDR" ] && printf "%s\r\n" "$AUTH_HDR"
        [ -n "$CLEN_HDR" ] && printf "%s\r\n" "$CLEN_HDR"
        [ -n "$CTYPE_HDR" ] && printf "%s\r\n" "$CTYPE_HDR"
        if [ -n "$CUSTOM_HEADERS" ]; then
            printf "%s" "$CUSTOM_HEADERS" | while IFS= read -r hdr_line; do
                [ -n "$hdr_line" ] && printf "%s\r\n" "$hdr_line"
            done
        fi
        printf "\r\n"
        [ "$HAS_DATA" -eq 1 ] && printf "%s" "$DATA"
    ) | nc $NC_OPTS "$host" "$port" > "$RESP_TMP"
    return $?
}

hop=0
max_hops=5
hdr_bytes=0
while :; do
    parse_url
    [ "$VERBOSE" -eq 1 ] && echo "* Connecting to $host port $port..." >&2

    do_request_to_file
    rc=$?
    if [ "$rc" -ne 0 ]; then
        [ "$SILENT" -eq 0 ] && echo "curl: failed to connect to $host port $port" >&2
        exit "$rc"
    fi
    if [ ! -s "$RESP_TMP" ]; then
        [ "$SILENT" -eq 0 ] && echo "curl: empty reply from server" >&2
        exit 52
    fi

    hdr_info=$(LC_ALL=C awk '
    NR == 1 {
        line = $0
        sub(/\r$/, "", line)
        split(line, f, /[ \t]+/)
        code = f[2] + 0
    }
    {
        total += length($0) + 1
        line = $0
        sub(/\r$/, "", line)
        if (line == "") {
            found = 1
            exit
        }
        if (tolower(line) ~ /^location:[ \t]*/) {
            loc = line
            sub(/^[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:[ \t]*/, "", loc)
            sub(/[ \t]*$/, "", loc)
        }
    }
    END {
        if (!found) total = 0
        printf "%d %d %s\n", total, code, loc
    }' "$RESP_TMP")

    hdr_bytes="${hdr_info%% *}"
    rest="${hdr_info#* }"
    status_code="${rest%% *}"
    case "$rest" in
        *" "*) loc="${rest#* }" ;;
        *)     loc="" ;;
    esac

    if [ "$FOLLOW_REDIRECT" -eq 1 ] && [ -n "$loc" ] && \
       { [ "$status_code" -eq 301 ] || [ "$status_code" -eq 302 ] || \
         [ "$status_code" -eq 303 ] || [ "$status_code" -eq 307 ] || [ "$status_code" -eq 308 ]; }; then
        if [ "$hop" -ge "$max_hops" ]; then
            [ "$SILENT" -eq 0 ] && echo "curl: maximum ($max_hops) redirects followed" >&2
            exit 47
        fi
        hop=$((hop + 1))
        case "$loc" in
            https://*)
                [ "$SILENT" -eq 0 ] && echo "curl: HTTPS is not supported on this firmware (HTTP only)" >&2
                exit 1
                ;;
            http://*)
                URL="$loc"
                ;;
            //*)
                URL="http:$loc"
                ;;
            /*)
                URL="http://${hostport}${loc}"
                ;;
            *)
                base_dir="${path%/*}"
                [ -z "$base_dir" ] && base_dir=""
                URL="http://${hostport}${base_dir}/${loc}"
                ;;
        esac
        if [ "$status_code" -eq 301 ] || [ "$status_code" -eq 302 ] || [ "$status_code" -eq 303 ]; then
            if [ "$METHOD" != "HEAD" ] && [ "$METHOD" != "GET" ]; then
                METHOD="GET"
                DATA=""
                HAS_DATA=0
            fi
        fi
        [ "$VERBOSE" -eq 1 ] && echo "* Redirecting ($status_code) to $URL" >&2
        continue
    fi
    break
done

CR=$(printf '\r')
if [ "$HEAD_ONLY" -eq 1 ]; then
    # Print headers only
    if [ "$OUTFILE" = "-" ]; then
        sed "/^${CR}*$/q" "$RESP_TMP"
    else
        sed "/^${CR}*$/q" "$RESP_TMP" > "$OUTFILE"
    fi
elif [ "$INCLUDE_HDR" -eq 1 ]; then
    # Print headers + body verbatim
    if [ "$OUTFILE" = "-" ]; then
        cat "$RESP_TMP"
    else
        cat "$RESP_TMP" > "$OUTFILE"
    fi
else
    # Body only (binary-safe byte offset past headers)
    if [ "$hdr_bytes" -gt 0 ]; then
        start_byte=$((hdr_bytes + 1))
        if [ "$OUTFILE" = "-" ]; then
            tail -c +"$start_byte" "$RESP_TMP"
        else
            tail -c +"$start_byte" "$RESP_TMP" > "$OUTFILE"
        fi
    else
        if [ "$OUTFILE" = "-" ]; then
            cat "$RESP_TMP"
        else
            cat "$RESP_TMP" > "$OUTFILE"
        fi
    fi
fi
