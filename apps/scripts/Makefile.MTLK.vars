E_ARCH=armv4
# TODO : comments
E_HOST=armv4
E_CROSS ?=$(E_TOPDIR)/../tools/arm-uclibc-3.4.6/
E_KERNEL ?=$(E_TOPDIR)/../kernel/linux-2.6.16-star/
E_CC ?=$(E_CROSS)/bin/arm-linux-uclibc-gcc
E_CXX ?=$(E_CROSS)/bin/arm-linux-uclibc-g++
E_CPP ?=$(E_CROSS)/bin/arm-linux-uclibc-cpp
E_STRIP ?=$(E_CROSS)/bin/arm-linux-uclibc-strip
E_LD ?=$(E_CROSS)/bin/arm-linux-uclibc-ld
E_AR ?=$(E_CROSS)/bin/arm-linux-uclibc-ar
E_INCLUDE ?=-I$(E_CROSS)/include/
E_CFLAGS ?=-I$(E_CROSS)/include/
E_LDFLAGS ?=-L$(E_CROSS)/lib/
E_DEST ?=$(E_TOPDIR)/../rootfs
E_SRC ?=$(E_TOPDIR)/../rootfs-star
E_DEBUGFS ?=$(E_TOPDIR)/../debugfs/output
#E_DEBUGFS ?=$(E_TOPDIR)/../debug-fs
#E_DEBUGFS ?=/tftp
E_TFTP_IP=172.16.20.39
E_NFS_IP=172.16.20.39
E_NFS_DIR="/tftp"
