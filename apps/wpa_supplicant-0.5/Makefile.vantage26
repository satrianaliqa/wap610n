CROSS_COMPILE=/opt/toolchains/sigma/8634_jabil/toolchain26/toolchain/build_mipsel_nofpu/staging_dir/bin/mipsel-linux-
CFLAGS=-O2
CC=${CROSS_COMPILE}gcc
STRIP=${CROSS_COMPILE}strip
export CC STRIP CFLAGS

all:
	make

clean:
	make clean

