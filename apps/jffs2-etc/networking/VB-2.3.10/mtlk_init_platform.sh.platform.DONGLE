#!/bin/sh

# This script sets platform specific settings for the dongle.

RWFS_PATH=/mnt/jffs2
ROOT_PATH=$RWFS_PATH
CONFIGS_PATH=$RWFS_PATH
IMAGES_PATH=$ROOT_PATH/images
DRIVER_PATH=$ROOT_PATH/driver
ETC_PATH=$ROOT_PATH/etc
WEB_PATH=$ROOT_PATH/web
BCL_PATH=$ROOT_PATH/bcl
SAVED_CONFIG_PATH=$ROOT_PATH/saved_configs
WPA_APPS_PATH=$ETC_PATH
WPA_CONFIGS_PATH=$ROOT_PATH/etc

# Start the led manager on the dongle
LEDMAN=1

# Dongle has no pushbutton for WPS
WPS_PB=0

# Don't use lower memory usage - use default net queues
LOWER_MEM_USAGE=0

# Use tc queues
CONFIGURE_TC=1

# Don't mangle multicast packets (this is done on STAR to reduce CPU utilization)
MULTICAST_MANGLING=0

# Run the restore defaults script that tries to download a restore-defaults script from tftp.
# (This is needed on platforms that don't have a HW PB for restore defaults)
SW_RESTORE_DEFAULTS=1

### Export all configuration options that need to be run outside a shell, e.g. from tclsh
# TODO: For safety's sake - export everything from this file?
# You could then use this file to initialize web_config.tcl
export CONFIGURE_TC RWFS_PATH ROOT_PATH CONFIGS_PATH IMAGES_PATH DRIVER_PATH ETC_PATH WEB_PATH BCL_PATH SAVED_CONFIG_PATH WPA_APPS_PATH WPA_CONFIGS_PATH
